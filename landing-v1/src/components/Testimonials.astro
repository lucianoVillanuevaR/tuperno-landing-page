---
import { TESTIMONIALS } from '../config/testimonials';

const featuredTestimonial = TESTIMONIALS.find(t => t.featured);
const regularTestimonials = TESTIMONIALS.filter(t => !t.featured);

const colorClasses: Record<string, string> = {
	orange: 'bg-orange-500',
	blue: 'bg-blue-500',
	green: 'bg-green-500',
	purple: 'bg-purple-500',
	pink: 'bg-pink-500'
};
---

<section class="bg-gray-50 py-16">
	<div class="container mx-auto px-6 max-w-4xl">
		<h2 class="text-2xl lg:text-3xl font-bold text-center text-gray-900 mb-3 animate-on-scroll animate-fade-in-up">
			Lo que dicen nuestros clientes
		</h2>
		<p class="text-center text-gray-600 mb-12 text-base animate-on-scroll animate-fade-in-up animation-delay-100">
			Testimonios reales de personas que confían en nosotros
		</p>

		{featuredTestimonial && (
			<div class="bg-white rounded-3xl p-8 shadow-xl max-w-3xl mx-auto animate-on-scroll animate-scale-in animation-delay-200 hover-lift">
				<div class="text-center space-y-4">
					<div class="flex gap-1 justify-center mb-3">
						{[...Array(featuredTestimonial.rating)].map(() => (
							<span class="text-yellow-400 text-xl">⭐</span>
						))}
					</div>
					<p class="text-xl text-gray-700 leading-relaxed italic">
						"{featuredTestimonial.comment}"
					</p>
					<div class="flex items-center gap-3 justify-center">
						<div class={`w-10 h-10 ${colorClasses[featuredTestimonial.color]} rounded-full flex items-center justify-center text-white font-bold`}>
							{featuredTestimonial.initials}
						</div>
						<div>
							<p class="font-bold text-gray-900 text-lg">{featuredTestimonial.name}</p>
							<p class="text-gray-600 text-sm">Cliente satisfecho</p>
						</div>
					</div>
				</div>
			</div>
		)}

		<div class="grid md:grid-cols-2 gap-6 mt-10 max-w-5xl mx-auto">
			{regularTestimonials.map((testimonial, index) => (
				<div class={`bg-white rounded-2xl p-6 shadow-lg animate-on-scroll animate-fade-in-up animation-delay-${300 + (index * 100)} hover-lift`}>
					<div class="flex gap-1 mb-3">
						<span class="text-yellow-400 text-base">⭐⭐⭐⭐⭐</span>
					</div>
					<p class="text-gray-700 text-sm italic mb-4">
						"{testimonial.comment}"
					</p>
					<div class="flex items-center gap-3">
						<div class={`w-10 h-10 ${colorClasses[testimonial.color]} rounded-full flex items-center justify-center text-white font-bold text-sm`}>
							{testimonial.initials}
						</div>
						<div>
							<p class="font-bold text-gray-900 text-sm">{testimonial.name}</p>
							<p class="text-xs text-gray-600">Cliente</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
