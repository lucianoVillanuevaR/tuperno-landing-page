---
import { CONTACT_INFO, BUSINESS_HOURS, SOCIAL_MEDIA } from '../config/constants';

const whatsappCTA = `${CONTACT_INFO.whatsappUrl}?text=Hola,%20necesito%20información`;
---

<section id="ubicacion" class="py-16 pb-12" style="background: linear-gradient(135deg, #121212 0%, #B71C1C 100%);">
	<div class="container mx-auto px-6 max-w-5xl">
		<div class="text-center text-white space-y-6 mb-12 animate-on-scroll animate-fade-in-up">
			<h2 class="text-3xl lg:text-4xl font-black">
				¿Listo para encontrar todo lo que necesitas?
			</h2>
			<p class="text-lg lg:text-xl opacity-90 max-w-3xl mx-auto">
				Visítanos en San Pedro de la Paz o contáctanos por WhatsApp
			</p>
			
			<div class="flex flex-col sm:flex-row gap-4 justify-center pt-3">
				<a href={whatsappCTA}
				   target="_blank"
				   rel="noopener noreferrer"
				   class="btn-cta-primary hover-shine">
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
					ESCRÍBENOS AHORA
				</a>
				<a href={CONTACT_INFO.mapsUrl}
				   target="_blank"
				   rel="noopener noreferrer"
				   class="btn-cta-secondary hover-shine">
					📍 CÓMO LLEGAR
				</a>
			</div>
		</div>

		<div class="grid md:grid-cols-4 gap-4 mb-12">
			<div class="info-card animate-on-scroll animate-fade-in-up animation-delay-100 hover-lift">
				<svg class="text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
				</svg>
				<h3 class="info-title">Ubicación</h3>
				<p class="info-text">{CONTACT_INFO.address.street}</p>
				<p class="info-subtext">{CONTACT_INFO.address.city}, {CONTACT_INFO.address.region}</p>
			</div>
			
			<div class="info-card">
				<svg class="text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
				</svg>
				<h3 class="info-title">Teléfono</h3>
				<p class="info-text font-bold text-base">{CONTACT_INFO.phoneDisplay}</p>
				<p class="info-subtext">Respuesta inmediata</p>
			</div>
			
			<div class="info-card animate-on-scroll animate-fade-in-up animation-delay-200 hover-lift">
				<svg class="text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
				</svg>
				<h3 class="info-title">Correo</h3>
				<a href={`mailto:${CONTACT_INFO.email}`} class="info-link">
					{CONTACT_INFO.email}
				</a>
				<p class="info-subtext">Escríbenos</p>
			</div>
			
			<div class="info-card animate-on-scroll animate-fade-in-up animation-delay-300 hover-lift">
				<svg class="text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
				<h3 class="info-title">Horario</h3>
				<p class="info-text">{BUSINESS_HOURS.weekdays}</p>
				<p class="info-text">{BUSINESS_HOURS.saturday}</p>
			</div>
		</div>

		<div class="mt-10 mb-8 animate-on-scroll animate-fade-in-up animation-delay-400">
			<h3 class="text-center text-white font-bold text-lg mb-4">
				📍 Encuéntranos en San Pedro de la Paz
			</h3>
			<div class="relative w-full max-w-2xl mx-auto hover-lift">
				<div class="relative rounded-lg overflow-hidden shadow-md border border-white/20" style="height: 240px;">
					<iframe
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3168.8!2d-73.1149!3d-36.8323!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9669b5f7f0e8e8e1%3A0x1!2sAv.%20Pedro%20Aguirre%20Cerda%2C%20San%20Pedro%20de%20la%20Paz%2C%20B%C3%ADo%20B%C3%ADo%2C%20Chile!5e0!3m2!1ses!2sus!4v1234567890"
						width="100%"
						height="100%"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="grayscale-0 hover:grayscale-0 transition-all duration-300"
					title="Ubicación Tuperno - San Pedro de la Paz"
					></iframe>
				</div>
				<div class="mt-2 text-center">
					<a href={CONTACT_INFO.mapsUrl}
					   target="_blank"
					   rel="noopener noreferrer"
					   class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-4 py-2 rounded-full transition-all duration-300 backdrop-blur-sm border border-white/30 text-xs">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
						</svg>
						Abrir en Google Maps
					</a>
				</div>
			</div>
		</div>

		<div class="border-t border-white/10 my-12"></div>

		<div class="mb-10">
			<h3 class="text-center text-white font-bold text-xl mb-6">Medios de Pago Disponibles</h3>
			<div class="flex flex-wrap justify-center items-center gap-6">
				<div class="payment-method">
					<div class="flex items-center gap-2">
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
					</svg>
						<div class="text-left">
							<p class="text-white font-bold text-sm">Tarjetas Crédito/Débito</p>
							<p class="text-white/80 text-xs">Chip, Contactless, Banda</p>
						</div>
					</div>
				</div>
				
				<div class="payment-method">
					<div class="flex items-center gap-2">
					<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
					</svg>
						<div class="text-left">
							<p class="text-white font-bold text-sm">Pago Móvil NFC</p>
							<p class="text-white/80 text-xs">Apple Pay, Google Pay</p>
						</div>
					</div>
				</div>
				
				<div class="payment-method">
					<div class="flex items-center gap-2">
					<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
					</svg>
						<div class="text-left">
							<p class="text-white font-bold text-sm">Transferencia</p>
							<p class="text-white/80 text-xs">Bancaria</p>
						</div>
					</div>
				</div>
				
				<div class="payment-method">
					<div class="flex items-center gap-2">
					<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
					</svg>
						<div class="text-left">
							<p class="text-white font-bold text-sm">Efectivo</p>
							<p class="text-white/80 text-xs">En local</p>
						</div>
					</div>
				</div>
			</div>
			<p class="text-center text-white/70 text-sm mt-3">Sistema POS TUU - Pagos seguros y rápidos</p>
		</div>
		
		<div class="mb-6 text-center">
			<h3 class="text-white font-semibold text-base mb-3">Síguenos en Redes Sociales</h3>
			<div class="flex justify-center gap-3">
				<a href={SOCIAL_MEDIA.facebook}
				   target="_blank"
				   rel="noopener noreferrer"
				   class="social-button">
					<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
						<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
					</svg>
				<span class="font-bold">Tuperno</span>
				</a>
				<a href={SOCIAL_MEDIA.instagram}
				   target="_blank"
				   rel="noopener noreferrer"
				   class="social-button">
					<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
					</svg>
					<span class="font-bold">{SOCIAL_MEDIA.instagramHandle}</span>
				</a>
			</div>
		</div>

		<div class="border-t border-white/10 pt-8 text-center">
			<p class="text-white/90 text-sm md:text-base font-medium">
				© 2026 TuPerno - Ferretería en {CONTACT_INFO.address.city}, {CONTACT_INFO.address.region} | Todos los derechos reservados
			</p>
			<p class="text-white/70 text-xs md:text-sm mt-2">
				{CONTACT_INFO.address.street} · {CONTACT_INFO.address.city}
			</p>
			<p class="text-white/70 text-xs md:text-sm mt-1">
				 {CONTACT_INFO.phoneDisplay} ·  <a href={`mailto:${CONTACT_INFO.email}`} class="hover:text-yellow-300 transition-colors">{CONTACT_INFO.email}</a>
			</p>
			<p class="text-white/60 text-xs md:text-sm mt-2">
				Pernos · Tornillos · Herramientas · Materiales de Construcción
			</p>
		</div>
	</div>
</section>

<button id="scrollToTop" class="scroll-to-top" aria-label="Volver arriba">
	<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
	</svg>
</button>

<style>
	.btn-cta-primary {
		background: #FBC02D;
		color: #121212;
		padding: 0.875rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.btn-cta-primary:hover {
		background: #F9A825;
		transform: scale(1.05);
	}

	.btn-cta-secondary {
		background: white;
		color: #B71C1C;
		padding: 0.875rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.btn-cta-secondary:hover {
		transform: scale(1.05);
	}

	.info-card {
		background: rgba(251, 192, 45, 0.15);
		backdrop-filter: blur(10px);
		border-radius: 0.75rem;
		padding: 1.25rem 1rem;
		text-align: center;
		border: 1px solid rgba(255, 255, 255, 0.25);
		transition: all 0.3s ease;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
	}

	.info-card:hover {
		background: rgba(251, 192, 45, 0.25);
		transform: translateY(-5px);
		box-shadow: 0 8px 12px rgba(0, 0, 0, 0.3);
	}

	.info-card svg {
		width: 2rem;
		height: 2rem;
		margin: 0 auto 0.5rem;
	}

	.info-title {
		font-weight: bold;
		font-size: 0.95rem;
		margin-bottom: 0.375rem;
		color: white;
	}

	.info-text {
		color: white;
		line-height: 1.5;
		font-size: 0.8rem;
	}

	.info-subtext {
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.7rem;
		margin-top: 0.25rem;
	}

	.info-link {
		color: white;
		font-weight: normal;
		font-size: 0.8rem;
		display: block;
		word-break: break-all;
		text-decoration: none;
	}

	.info-link:hover {
		color: rgba(255, 255, 255, 0.9);
		text-decoration: underline;
	}

	.payment-method {
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(4px);
		border-radius: 1rem;
		padding: 1.25rem 2rem;
		transition: all 0.3s ease;
	}

	.payment-method:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.social-button {
		background: linear-gradient(135deg, #FBC02D 0%, #F9A825 100%);
		color: #121212;
		padding: 1rem;
		border-radius: 1rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.social-button:hover {
		transform: scale(1.1);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
	}

	.scroll-to-top {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 3.5rem;
		height: 3.5rem;
		background: linear-gradient(135deg, #FBC02D 0%, #F9A825 100%);
		color: #121212;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 20px rgba(251, 192, 45, 0.4);
		z-index: 1000;
		opacity: 0;
		visibility: hidden;
		transform: translateY(100px);
		transition: all 0.3s ease;
	}

	.scroll-to-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.scroll-to-top:hover {
		background: linear-gradient(135deg, #F9A825 0%, #F57F17 100%);
		transform: translateY(-5px);
		box-shadow: 0 6px 25px rgba(251, 192, 45, 0.6);
	}

	.scroll-to-top:active {
		transform: translateY(-2px);
	}

	@media (max-width: 768px) {
		.scroll-to-top {
			width: 3rem;
			height: 3rem;
			bottom: 1.5rem;
			right: 1.5rem;
		}
	}
</style>

<script>
	const scrollToTopBtn = document.getElementById('scrollToTop');

	window.addEventListener('scroll', () => {
		if (window.scrollY > 300) {
			scrollToTopBtn?.classList.add('visible');
		} else {
			scrollToTopBtn?.classList.remove('visible');
		}
	});

	scrollToTopBtn?.addEventListener('click', () => {
		window.scrollTo({
			top: 0,
			behavior: 'smooth'
		});
	});
</script>
