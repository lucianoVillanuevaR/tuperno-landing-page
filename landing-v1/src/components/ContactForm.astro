---
import { CONTACT_INFO } from '../config/constants';

const whatsappFormUrl = `${CONTACT_INFO.whatsappUrl}?text=Hola,%20necesito%20información%20sobre%20productos`;
---

<section class="bg-slate-50 py-12">
	<div class="container mx-auto px-6 max-w-4xl">
		<div class="bg-gradient-to-br from-blue-50 to-slate-50 rounded-3xl shadow-2xl overflow-hidden border-2 border-slate-200 animate-on-scroll animate-fade-in-up hover-lift">
			<div class="p-8">
				<div class="text-center mb-8">
					<h2 class="text-3xl md:text-4xl font-black text-primary mb-3 tracking-tight animate-on-scroll animate-fade-in-up">
						¿Necesitas pernos o fijaciones especiales?
					</h2>
					<p class="text-lg text-slate-700 max-w-2xl mx-auto leading-relaxed animate-on-scroll animate-fade-in-up animation-delay-100">
						Contáctanos ahora y recibe asesoría personalizada. Stock completo y entrega rápida.
					</p>
				</div>

				<div class="grid lg:grid-cols-2 gap-6">

					<div class="space-y-4 animate-on-scroll animate-slide-in-left animation-delay-200">
						<div class="bg-slate-50 rounded-2xl shadow-lg overflow-hidden hover-scale">
							<img src="/images/TuPernoLocal.png" alt="Local Tuperno - Ferretería en San Pedro de la Paz" class="w-full h-40 object-cover" />
						</div>

						<div class="space-y-2">
							<div class="flex items-start gap-2">
								<span class="text-green-500 text-xl flex-shrink-0">✓</span>
								<p class="text-slate-700 text-sm"><strong>Todas las medidas disponibles</strong> - Stock completo</p>
							</div>
							<div class="flex items-start gap-2">
								<span class="text-green-500 text-xl flex-shrink-0">✓</span>
								<p class="text-slate-700 text-sm"><strong>Entrega rápida</strong> - Asesoría personalizada</p>
							</div>
							<div class="flex items-start gap-2">
								<span class="text-green-500 text-xl flex-shrink-0">✓</span>
							<p class="text-slate-700 text-sm"><strong>Precios competitivos</strong> - Calidad garantizada</p>
							</div>
						</div>

						<div class="grid grid-cols-3 gap-4 pt-4">
							<div class="text-center">
								<div class="w-16 h-16 bg-gradient-to-br from-red-600 to-red-700 rounded-full flex items-center justify-center mx-auto mb-2 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
									</svg>
								</div>
								<p class="text-xs font-bold text-slate-800">+400 productos</p>
							</div>
							<div class="text-center">
								<div class="w-16 h-16 bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-2 shadow-lg">
									<svg class="w-7 h-7 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
									</svg>
								</div>
								<p class="text-xs font-bold text-slate-800">Respuesta inmediata</p>
							</div>
							<div class="text-center">
								<div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center mx-auto mb-2 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
									</svg>
								</div>
								<p class="text-xs font-bold text-slate-800">Garantía total</p>
							</div>
						</div>
					</div>

					<div class="bg-slate-50 rounded-2xl shadow-xl p-6 animate-on-scroll animate-slide-in-right animation-delay-200">
						<h3 class="text-xl font-black text-primary mb-5 text-center tracking-tight">
						Contáctanos
						</h3>
						<form class="space-y-4" id="catalogForm" novalidate>
							<div>
								<input 
									type="text" 
									id="form-nombre"
									name="nombre"
									required
									minlength="3"
									maxlength="50"
									class="form-input"
									placeholder="Nombre completo"
									autocomplete="name"
								/>
								<p class="error-message" id="error-nombre"></p>
							</div>
							<div>
								<input 
									type="email"
									id="form-email"
									name="email"
									required
									class="form-input"
									placeholder="Correo electrónico"
									autocomplete="email"
								/>
								<p class="error-message" id="error-email"></p>
							</div>
							<div>
								<input 
									type="tel"
									id="form-telefono"
									name="telefono"
									class="form-input"
									placeholder="Teléfono (opcional)"
									autocomplete="tel"
									pattern="[+]?[0-9]{8,12}"
								/>
								<p class="error-message" id="error-telefono"></p>
							</div>
							<button 
								type="submit"
								id="submit-btn"
								class="btn-submit hover-shine">
								CONTÁCTANOS
							</button>
						</form>

						<div class="mt-5 pt-5 border-t-2 border-slate-200">
							<a href={whatsappFormUrl}
							   target="_blank"
							   rel="noopener noreferrer"
							   class="btn-whatsapp hover-shine">
								<span class="inline-flex items-center justify-center gap-2">
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
									ESCRÍBENOS POR WHATSAPP
								</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.text-primary {
		color: #B71C1C;
	}

	.bg-primary {
		background: #B71C1C;
	}

	.bg-secondary {
		background: #FBC02D;
	}

	.form-input {
		width: 100%;
		padding: 0.875rem 1rem;
		border-radius: 0.875rem;
		border: 2px solid #e2e8f0;
		transition: all 0.3s ease;
		font-size: 0.9375rem;
		background-color: #f8fafc;
	}

	.form-input:focus {
		outline: none;
		border-color: #B71C1C;
		box-shadow: 0 0 0 3px rgba(183, 28, 28, 0.1);
		background-color: #ffffff;
	}

	.form-input.error {
		border-color: #dc2626;
		background-color: #fef2f2;
	}

	.form-input.success {
		border-color: #10b981;
		background-color: #f0fdf4;
	}

	.error-message {
		color: #dc2626;
		font-size: 0.75rem;
		margin-top: 0.25rem;
		min-height: 1rem;
		font-weight: 500;
	}

	.btn-submit {
		width: 100%;
		background: linear-gradient(135deg, #FBC02D 0%, #F9A825 100%);
		color: #121212;
		padding: 1rem 1.5rem;
		border-radius: 0.875rem;
		font-weight: bold;
		font-size: 1.0625rem;
		box-shadow: 0 10px 25px -5px rgba(251, 192, 45, 0.3);
		transition: all 0.3s ease;
		border: none;
		cursor: pointer;
		letter-spacing: 0.025em;
	}

	.btn-submit:hover {
		background: linear-gradient(135deg, #F9A825 0%, #F57F17 100%);
		box-shadow: 0 15px 30px -5px rgba(251, 192, 45, 0.4);
		transform: translateY(-2px);
	}

	.btn-submit:disabled {
		background: #9ca3af;
		cursor: not-allowed;
		transform: none;
		opacity: 0.6;
	}

	.btn-submit:disabled:hover {
		background: #9ca3af;
		transform: none;
	}

	.btn-whatsapp {
		display: block;
		width: 100%;
		background: #10b981;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 0.9rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		text-align: center;
	}

	.btn-whatsapp:hover {
		background: #059669;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
		transform: scale(1.05);
	}
</style>

<script>
	const form = document.getElementById('catalogForm') as HTMLFormElement;
	const nombreInput = document.getElementById('form-nombre') as HTMLInputElement;
	const emailInput = document.getElementById('form-email') as HTMLInputElement;
	const telefonoInput = document.getElementById('form-telefono') as HTMLInputElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

	const errorNombre = document.getElementById('error-nombre') as HTMLElement;
	const errorEmail = document.getElementById('error-email') as HTMLElement;
	const errorTelefono = document.getElementById('error-telefono') as HTMLElement;

	const nombreRegex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]{3,50}$/;
	const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
	const telefonoRegex = /^[+]?[0-9]{8,12}$/;

	function validarNombre(valor: string): { valido: boolean; mensaje: string } {
		if (!valor.trim()) {
			return { valido: false, mensaje: 'El nombre es obligatorio' };
		}
		if (valor.trim().length < 3) {
			return { valido: false, mensaje: 'El nombre debe tener al menos 3 caracteres' };
		}
		if (!nombreRegex.test(valor)) {
			return { valido: false, mensaje: 'Solo se permiten letras y espacios' };
		}
		return { valido: true, mensaje: '' };
	}

	function validarEmail(valor: string): { valido: boolean; mensaje: string } {
		if (!valor.trim()) {
			return { valido: false, mensaje: 'El correo electrónico es obligatorio' };
		}
		if (!emailRegex.test(valor)) {
			return { valido: false, mensaje: 'Ingresa un correo electrónico válido' };
		}
		return { valido: true, mensaje: '' };
	}

	function validarTelefono(valor: string): { valido: boolean; mensaje: string } {
		if (!valor.trim()) {
			return { valido: true, mensaje: '' }; // Opcional
		}
		if (!telefonoRegex.test(valor)) {
			return { valido: false, mensaje: 'Formato inválido (ej: +56912345678)' };
		}
		return { valido: true, mensaje: '' };
	}

	function actualizarEstadoCampo(
		input: HTMLInputElement,
		errorElement: HTMLElement,
		resultado: { valido: boolean; mensaje: string }
	) {
		if (resultado.valido) {
			input.classList.remove('error');
			input.classList.add('success');
			errorElement.textContent = '';
		} else {
			input.classList.remove('success');
			input.classList.add('error');
			errorElement.textContent = resultado.mensaje;
		}
	}

	nombreInput?.addEventListener('blur', () => {
		const resultado = validarNombre(nombreInput.value);
		actualizarEstadoCampo(nombreInput, errorNombre, resultado);
	});

	emailInput?.addEventListener('blur', () => {
		const resultado = validarEmail(emailInput.value);
		actualizarEstadoCampo(emailInput, errorEmail, resultado);
	});

	telefonoInput?.addEventListener('blur', () => {
		const resultado = validarTelefono(telefonoInput.value);
		actualizarEstadoCampo(telefonoInput, errorTelefono, resultado);
	});

	[nombreInput, emailInput, telefonoInput].forEach(input => {
		input?.addEventListener('input', () => {
			input.classList.remove('error');
		});
	});

	function validarFormulario(): boolean {
		const nombreValido = validarNombre(nombreInput.value);
		const emailValido = validarEmail(emailInput.value);
		const telefonoValido = validarTelefono(telefonoInput.value);

		actualizarEstadoCampo(nombreInput, errorNombre, nombreValido);
		actualizarEstadoCampo(emailInput, errorEmail, emailValido);
		actualizarEstadoCampo(telefonoInput, errorTelefono, telefonoValido);

		return nombreValido.valido && emailValido.valido && telefonoValido.valido;
	}

	// Enviar formulario
	form?.addEventListener('submit', (e) => {
		e.preventDefault();

		if (!validarFormulario()) {
			const primerError = form.querySelector('.error') as HTMLElement;
			primerError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = 'ENVIANDO...';

		const nombre = nombreInput.value.trim();
		const email = emailInput.value.trim();
		const telefono = telefonoInput.value.trim();

		let mensaje = `Hola, soy ${nombre}. Necesito información sobre pernos y fijaciones.\n\n`;
		mensaje += `📧 Email: ${email}`;
		if (telefono) {
			mensaje += `\n📱 Teléfono: ${telefono}`;
		}

		const whatsappUrl = `https://wa.me/56951997763?text=${encodeURIComponent(mensaje)}`;
		
		window.open(whatsappUrl, '_blank');

		setTimeout(() => {
			form.reset();
			[nombreInput, emailInput, telefonoInput].forEach(input => {
				input?.classList.remove('success', 'error');
			});
			[errorNombre, errorEmail, errorTelefono].forEach(error => {
				error.textContent = '';
			});
			submitBtn.disabled = false;
			submitBtn.textContent = 'QUIERO EL CATÁLOGO';
		}, 2000);
	});
</script>
