---
import { CONTACT_INFO } from '../config/constants';

const whatsappMessage = 'Hola,%20necesito%20información';
const whatsappUrl = `${CONTACT_INFO.whatsappUrl}?text=${whatsappMessage}`;
---

<section class="bg-gradient-to-br from-gray-50 to-white py-6 lg:py-8 relative overflow-hidden">
	<div class="absolute inset-0 flex items-center justify-center opacity-12 pointer-events-none">
		<img src="/images/pernos.png" alt="" class="w-full h-full object-cover scale-110" />
	</div>
	
	<div class="container mx-auto px-6 max-w-6xl relative z-10">
		<div class="mb-6 lg:mb-8 flex justify-center">
			<img 
				src="/images/logo principal.png" 
				alt="Tuperno - Logo" 
				class="max-w-md w-full h-auto object-contain px-4"
			/>
		</div>

		<div class="text-center space-y-5 lg:space-y-6 max-w-4xl mx-auto pt-4">
			<div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-md border border-slate-200 mx-auto animate-fade-in-up">
				<div class="flex gap-1">
					<span class="text-yellow-400 text-base">⭐</span>
					<span class="text-yellow-400 text-base">⭐</span>
					<span class="text-yellow-400 text-base">⭐</span>
					<span class="text-yellow-400 text-base">⭐</span>
					<span class="text-yellow-400 text-base">⭐</span>
				</div>
			<span class="text-sm font-semibold text-slate-700">Más de 400 clientes satisfechos</span>
			</div>

			<h1 class="text-3xl lg:text-5xl font-black leading-tight animate-fade-in-up animation-delay-100">
				<span class="text-primary">Especialistas en Pernos y Fijaciones</span>
				<span class="block text-secondary mt-1">en San Pedro de la Paz</span>
			</h1>

			<p class="text-base lg:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto animate-fade-in-up animation-delay-200">
			Pernos, tuercas, golillas, tornillos y artículos de ferretería. Atención personalizada y stock siempre disponible si no, lo traemos.
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center pt-2 animate-fade-in-up animation-delay-300">
				<a href={whatsappUrl}
				   target="_blank"
				   rel="noopener noreferrer"
				   class="btn-primary inline-flex items-center justify-center gap-2">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
					CONTÁCTANOS POR WHATSAPP
				</a>
				<a href="#ubicacion" 
				   class="btn-secondary hover-shine">
					VER UBICACIÓN
				</a>
			</div>

			<slot />
		</div>
	</div>
</section>

<style>
	.text-primary {
		color: #B71C1C;
	}

	.text-secondary {
		color: #121212;
	}

	.btn-primary {
		background: #FBC02D;
		color: #121212;
		padding: 1rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
	}

	.btn-primary:hover {
		background: #F9A825;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
		transform: scale(1.05);
	}

	.btn-secondary {
		background: #B71C1C;
		color: white;
		padding: 1rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
	}

	.btn-secondary:hover {
		background: #8B1515;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
		transform: scale(1.05);
	}
</style>
